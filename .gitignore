# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
.vercel

# production
/build

# testing
/coverage

# typescript
*.tsbuildinfo
next-env.d.ts

# env files — MONGODB_URI and JWT_SECRET live here (can opt-in for committing if needed)
.env
.env.*
!.env.example

# uploaded files (lab reports, etc.) — DO NOT commit patient data
/data/
/public/uploads/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# misc
.DS_Store
*.pem

# unzip cruft
__MACOSX/

# zip files
*.zip
