# Copy to .env.local (or .env) and fill in. Setup steps for the optional services: README, "Setting up the optional services".

# ── Required ──────────────────────────────────────────────────────────────────
# Public address of the site: used for Open Graph and canonical links.
SITE_URL="http://localhost:3000"
# Must be a REPLICA SET: order confirm, dispatch and schedule changes run in transactions.
MONGODB_URI="mongodb://127.0.0.1:27017/nutridrip"
# Signs every login. In production it must be your own private random value (at least 16 characters):
# the app refuses to run with this example value, which is public. Make one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-in-production-please-use-32-chars-min"
SESSION_EXPIRY_HOURS="24"

# ── Optional: address search and a map pin (Google Maps) ──────────────────────
# The server key is secret; the browser key is public and must be referrer-restricted.
# GOOGLE_MAPS_SERVER_KEY=""
# NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# ── Optional: online payment (Razorpay). Off until both keys are set. ─────────
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
# RAZORPAY_REFUND_SPEED="normal"   # or "optimum": instant refunds, charged per refund

# ── Optional: where uploaded site photos are kept (default ./storage) ─────────
# Needs a permanent disk and a backup alongside the database.
# STORAGE_DIR="/var/lib/nutridrip/storage"

# Design tooling only (scroll-craft image generation); the app never reads it.
KIE_AI_API_KEY=
